# Where reviews and analysis are stored
DB_PATH=data/reviews.db

# --- Analysis --------------------------------------------------------------
# auto = use the LLM when OPENAI_API_KEY or OPENAI_BASE_URL is set, otherwise the offline lexicon
ANALYZER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible server instead of OpenAI, e.g. Ollama:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1:8b
OPENAI_BASE_URL=
# json_schema = structured outputs; use json_object for servers that don't support them
LLM_JSON_MODE=json_schema
# Reviews per LLM call, and calls in flight at once
ANALYZE_BATCH_SIZE=8
ANALYZE_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Safety cap on reviews sent to the LLM per run
MAX_REVIEWS_PER_RUN=2000

# --- Scraping --------------------------------------------------------------
# Say who you are; sites are more forgiving of a bot that identifies itself
USER_AGENT=ReviewDashBot/0.1 (+https://github.com/your-name/review-sentiment-dashboard)
# Minimum gap between two requests to the same site
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGES=50
# Tries per page; 429/503 honor Retry-After, other failures back off exponentially
MAX_ATTEMPTS=4
RESPECT_ROBOTS_TXT=true

# Used by `seed-demo`
DEMO_STORE_URL=http://localhost:8090
ENCODE_TOKEN=enabled
DEQUEUE_BATCH=enabled
ENCODE_TOKEN=enabled